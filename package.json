{
  "name": "@pi-spice/monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "pi-spice monorepo container — each extension lives in extensions/ and publishes individually",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0x2E/pi-spice.git"
  },
  "workspaces": [
    "extensions/*"
  ],
  "scripts": {
    "release": "changeset publish",
    "typecheck": "tsc -p .",
    "smoke": "node --experimental-strip-types scripts/smoke/collapse-blocks.mjs",
    "check": "npm run typecheck && npm run smoke"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "@changesets/parse": "^1.0.0",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typescript": "^5.7.0",
    "typebox": "*"
  },
  "pi": {
    "extensions": [
      "extensions/*/index.ts"
    ]
  }
}

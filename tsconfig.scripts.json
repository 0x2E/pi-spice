{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // The smoke harness is plain Node: it reads files, spawns processes and
    // exits with a status, so it opts into Node types here. The root config
    // sets types: [] (no automatic @types inclusion).
    "types": ["node"]
  },
  "include": ["scripts/**/*.ts"]
}
